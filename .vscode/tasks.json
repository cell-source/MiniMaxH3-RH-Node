{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "� 打包 RunningHub 发布包（重建引擎+zip+sha256）",
            "type": "shell",
            "command": "python",
            "args": [
                "scripts/package_runninghub.py"
            ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "🧪 提示词节点单元测试",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/test_prompt_node.py",
                "-q"
            ],
            "group": "test",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "🌐 HTML 规则回归测试（需 Node）",
            "type": "shell",
            "command": "node",
            "args": [
                "tests/language-globalization.cjs"
            ],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
